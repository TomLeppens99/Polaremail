# Polar API Credentials
# Get these from https://admin.polaraccesslink.com
POLAR_CLIENT_ID=your_client_id
POLAR_CLIENT_SECRET=your_client_secret
POLAR_REDIRECT_URI=http://localhost:5000/callback

# User Configuration (populated after OAuth flow)
POLAR_USER_ID=
POLAR_ACCESS_TOKEN=

# Email Configuration
# For Gmail: Enable 2FA and create an App Password
# https://support.google.com/accounts/answer/185833
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_RECIPIENT=your_email@gmail.com
EMAIL_FROM_NAME=Polar Training Report

# Webhook Configuration
# Use ngrok or similar for local development: ngrok http 5000
WEBHOOK_URL=https://your-domain.com/webhook
WEBHOOK_SECRET=generate_a_secure_random_string_here

# Database Configuration
DATABASE_URL=sqlite:///polar_data.db

# Schedule Configuration
REPORT_DAY=Monday
REPORT_TIME=08:00
TIMEZONE=Europe/Brussels

# Application Configuration
FLASK_SECRET_KEY=generate_a_secure_random_string_here
FLASK_DEBUG=false
LOG_LEVEL=INFO
